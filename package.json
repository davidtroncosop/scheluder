{
  "name": "scheduler-pro",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "db:create": "wrangler d1 create scheduler-pro-db",
    "db:migrate": "wrangler d1 migrations apply scheduler-pro-db --local",
    "db:seed": "wrangler d1 execute scheduler-pro-db --local --file=./seed/demo_data.sql",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:backup": "bash ./scripts/db-backup.sh scheduler-pro-db",
    "db:rollback": "bash ./scripts/db-rollback.sh",
    "monitor:production": "node ./scripts/monitor-production.mjs",
    "pages:dev": "npm run build && wrangler pages dev ./dist",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name scheduler-pro --branch production"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@tailwindcss/forms": "^0.5.10",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.18",
    "undici": "^7.29.0"
  }
}
